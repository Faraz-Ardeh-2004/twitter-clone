<?xml version="1.0" encoding="UTF-8"?>

<!--
============================================================
Owner: Faraz (Frontend) | Phase 2 (Day 6-8) base + Phase 3/4 (like/reply/search)
============================================================
Per the spec: a box at the top for composing a tweet + a post button, and a
ScrollPane containing a VBox below for the feed. The search bar is added to
this same screen's header in Phase 4.
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.twitterclone.client.controller.DashboardController">

    <!-- TODO(Faraz - Phase 4): simple search bar goes here (in the header) -->
    <top>
        <HBox spacing="8.0" alignment="CENTER_LEFT">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <Label text="Twitter Clone" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <!-- TODO(Faraz - Phase 4): fx:id="searchField" + a search button + onAction to SEARCH_USERS/SEARCH_TWEETS -->
            <TextField fx:id="searchField" promptText="Search..." HBox.hgrow="ALWAYS"/>
            <Button fx:id="searchButton" text="Search" onAction="#onSearchButtonClick"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="10.0">
            <padding>
                <Insets top="10" right="20" bottom="10" left="20"/>
            </padding>

            <!-- tweet composer box -->
            <VBox spacing="6.0">
                <TextArea fx:id="tweetContentField" promptText="What's happening?" wrapText="true" prefRowCount="3"/>
                <!-- TODO(Faraz): onAction is wired to DashboardController#onPostTweetClick -->
                <Button fx:id="postTweetButton" text="Tweet" onAction="#onPostTweetClick"/>
            </VBox>

            <!-- feed: a ScrollPane containing the VBox that TweetCards get injected into -->
            <!-- TODO(Faraz - Phase 2): fx:id="feedContainer" is the VBox that
                 DashboardController adds a new card to at index 0, after
                 receiving a NEW_TWEET_PUSH packet. -->
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                <VBox fx:id="feedContainer" spacing="8.0"/>
            </ScrollPane>
        </VBox>
    </center>

</BorderPane>
